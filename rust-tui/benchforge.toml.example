# BenchForge Rust TUI Configuration
# Resolution order:
#   1. --config <path>
#   2. ./benchforge.toml
#   3. ~/.config/benchforge/config.toml
#   4. Built-in defaults

[execution]
mode = "parallel"        # "parallel" | "sequential"
concurrency = 3          # 1..=10 worker threads
timeout_sec = 300        # Per-request timeout in seconds
stream = true            # Enable SSE streaming
temperature = 0.7
max_tokens = 2048
top_p = 1.0
# seed = 42

[system_prompt]
enabled = false
persona = "concise-expert"   # "concise-expert" | "deep-analyst" | "code-architect"
target_mode = "all"          # "all" | "specific"
target_models = []
content = ""

[ui]
theme = "dark"               # "light" | "dark" | "sepia-light" | "sepia-dark" | "greenish-sepia"
history_limit = 50

[supabase]
url = ""
anon_key_env = "SUPABASE_ANON_KEY"
table_name = "benchmark_runs"
auto_sync = false

[[providers]]
id = "ollama-local"
name = "Ollama Local"
kind = "ollama"
base_url = "http://localhost:11434/v1"
api_key_env = ""
models = ["llama3.2:latest", "qwen2.5-coder:7b"]

[[providers]]
id = "openai"
name = "OpenAI API"
kind = "openai"
base_url = "https://api.openai.com/v1"
api_key_env = "OPENAI_API_KEY"
models = ["gpt-4o-mini", "gpt-4.1-mini"]

[[providers]]
id = "groq"
name = "Groq Cloud"
kind = "groq"
base_url = "https://api.groq.com/openai/v1"
api_key_env = "GROQ_API_KEY"
models = [
  "llama-3.3-70b-versatile",
  "llama-3.1-8b-instant",
  "qwen/qwen3-32b",
  "openai/gpt-oss-120b",
  "moonshotai/kimi-k2-instruct",
]

[[providers]]
id = "litellm"
name = "LiteLLM Proxy"
kind = "litellm"
base_url = "http://localhost:4100/v1"
api_key_env = "LITELLM_API_KEY"
models = [
  "gpt-4o-mini",
  "claude-3-7-sonnet",
  "gemini/gemini-2.5-flash",
  "deepseek/deepseek-chat",
]

[[providers]]
id = "lmstudio"
name = "LM Studio"
kind = "lmstudio"
base_url = "http://localhost:1234/v1"
api_key_env = ""
models = ["local-model"]

[[targets]]
id = "target-ollama-llama"
provider_id = "ollama-local"
model = "llama3.2:latest"
enabled = true

[[targets]]
id = "target-groq-llama70b"
provider_id = "groq"
model = "llama-3.3-70b-versatile"
enabled = true

[[targets]]
id = "target-groq-qwen3"
provider_id = "groq"
model = "qwen/qwen3-32b"
enabled = false

[[targets]]
id = "target-litellm-gpt4o"
provider_id = "litellm"
model = "gpt-4o-mini"
enabled = true

[[targets]]
id = "target-litellm-claude"
provider_id = "litellm"
model = "claude-3-7-sonnet"
enabled = false
